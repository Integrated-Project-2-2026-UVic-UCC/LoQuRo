<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>loquro_control</name>
  <version>0.1.0</version>
  <description>Nodes to command the LoQuRo quadruped: robot interface, routine player and policy player</description>
  <maintainer email="nllortfer@gmail.com">Nico</maintainer>
  <license>GPL-3.0-or-later</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>loquro_interfaces</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-onnxruntime-pip</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
