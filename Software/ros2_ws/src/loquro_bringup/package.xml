<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>loquro_bringup</name>
  <version>0.1.0</version>
  <description>Launch files and configuration to run the LoQuRo quadruped</description>
  <maintainer email="nllortfer@gmail.com">Nico</maintainer>
  <license>GPL-3.0-or-later</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>loquro_control</exec_depend>
  <exec_depend>loquro_description</exec_depend>
  <exec_depend>imu_filter_madgwick</exec_depend>
  <!-- zenoh-bridge-ros2dds 1.9.0 has no rosdep key: install it with apt, see the workspace README -->

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
